[Unit]
Description=Aggilli Music Upload API
After=network-online.target
Wants=network-online.target
Requires=aggilli-music-upload.socket
After=aggilli-music-upload.socket

[Service]
Type=simple
User=aggilli-upload
Group=aggilli-upload
SupplementaryGroups=aggilli-upload-secrets
WorkingDirectory=/home/gilliard/projetos/aggilli-music-upload
ExecStart=/home/gilliard/projetos/aggilli-music-upload/.venv/bin/python -m uvicorn main:app --fd 3
Sockets=aggilli-music-upload.socket
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
StateDirectory=aggilli-music/sync-requests
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
