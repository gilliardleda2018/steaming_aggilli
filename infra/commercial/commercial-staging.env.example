# Aggilli Music - API comercial em HOMOLOGAÇÃO.
# Instalado como /etc/aggilli-music/commercial-staging.env (root:root 0600).
# Preencha com o assistente: sudo bash scripts/configure-ani-staging.sh
# Nunca copie este arquivo preenchido para o GitHub ou para conversas.

# true somente depois de configurar o modelo e a chave.
AGGILLI_ANI_ENABLED=false
# anthropic = Claude pelo SDK oficial; openai-compatible = endpoint chat/completions.
AGGILLI_ANI_PROVIDER=anthropic
AGGILLI_ANI_MODEL=claude-opus-5-5
# Chave da API da Anthropic (console.anthropic.com > API Keys).
ANTHROPIC_API_KEY=

# Somente para AGGILLI_ANI_PROVIDER=openai-compatible.
AGGILLI_ANI_CHAT_URL=
AGGILLI_ANI_API_KEY=
