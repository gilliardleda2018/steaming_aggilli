# Aggilli Music - API comercial em HOMOLOGAÇÃO.
# Instalado como /etc/aggilli-music/commercial-staging.env (root:root 0600).
# Edite com: sudoedit /etc/aggilli-music/commercial-staging.env
# Depois: sudo systemctl restart aggilli-commercial-staging.service
# Nunca copie este arquivo preenchido para o GitHub ou para conversas.

# true somente depois de preencher as três linhas abaixo.
AGGILLI_ANI_ENABLED=false
# Endpoint HTTPS compatível com chat/completions, sem usuário, senha ou query.
AGGILLI_ANI_CHAT_URL=
AGGILLI_ANI_API_KEY=
AGGILLI_ANI_MODEL=
